# Variáveis de Ambiente - Modelo
# COPIE PARA .env.local E CUSTOMIZE PARA SEU AMBIENTE

# ============= REDIS =============
# Formato: host:port ou host:port,allowAdmin=true para cluster
REDIS_CONNECTION_STRING=redis:6379

# ============= HANGFIRE (PostgreSQL) =============
# Formato: Host=servidor;Port=5432;Database=db;Username=user;Password=pass
# Deve estar acessível de onde a aplicação está rodando
HANGFIRE_CONNECTION_STRING=Host=application-postgres;Port=5432;Database=evolution;Username=evolution;Password=evolution

# ============= JWT =============
JWT_ISSUER=ApplicationBase
JWT_AUDIENCE=ApplicationBaseClient
JWT_SIGNING_KEY=your-super-secret-key-change-in-production-at-least-32-chars

# ============= ENCRYPTION =============
# Chave para criptografia de dados sensíveis
APP_SECRET_ENCRYPTION_KEY=your-super-secret-encryption-key-min-32-chars!

# ============= RAVENDB =============
# URLs de acesso ao RavenDB (separadas por ; se multiple)
RAVENDBSETTINGS_URLS=https://ravendb:8443

# ============= EMAIL SETTINGS =============
EMAIL_FROM_NAME=ApplicationBase
EMAIL_FROM_ADDRESS=noreply@applicationbase.local
EMAIL_SMTP_HOST=mail
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=starttls
EMAIL_SMTP_PASSWORD=

# ============= MOODLE INTEGRATION =============
MOODLE_BASE_URL=https://moodle.example.com
MOODLE_SERVICE_NAME=ApplicationBase
MOODLE_API_TOKEN=
MOODLE_TIMEOUT_SECONDS=30
MOODLE_SYNC_BATCH_SIZE=50

# ============= WHATSAPP INTEGRATION =============
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_TOKEN=

# ============= ENVIRONMENT =============
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
