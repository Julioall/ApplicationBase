# Variáveis de Ambiente - Desenvolvimento Local
# COPIE ESTE ARQUIVO PARA .env E CUSTOMIZE CONFORME NECESSÁRIO

# ============= REDIS =============
REDIS_CONNECTION_STRING=localhost:6379

# ============= HANGFIRE (PostgreSQL) =============
# Formato: Host=servidor;Port=5432;Database=db;Username=user;Password=pass
HANGFIRE_CONNECTION_STRING=Host=localhost;Port=5432;Database=evolution;Username=evolution;Password=evolution

# ============= JWT =============
JWT_ISSUER=ApplicationBase
JWT_AUDIENCE=ApplicationBaseClient
JWT_SIGNING_KEY=your-secret-key-here-change-in-production-min-32-chars!!

# ============= ENCRYPTION =============
APP_SECRET_ENCRYPTION_KEY=your-encryption-key-here-min-32-chars!

# ============= RAVENDB =============
RAVENDBSETTINGS_URLS=https://localhost:8080

# ============= EMAIL SETTINGS =============
EMAIL_FROM_NAME=ApplicationBase
EMAIL_FROM_ADDRESS=noreply@applicationbase.local
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=starttls
EMAIL_SMTP_PASSWORD=

# ============= MOODLE INTEGRATION =============
MOODLE_BASE_URL=https://moodle.local
MOODLE_SERVICE_NAME=ApplicationBase
MOODLE_API_TOKEN=your-moodle-token-here
MOODLE_TIMEOUT_SECONDS=30
MOODLE_SYNC_BATCH_SIZE=50

# ============= WHATSAPP INTEGRATION =============
WHATSAPP_API_URL=https://api.whatsapp.local
WHATSAPP_API_TOKEN=your-whatsapp-token-here

# ============= ENVIRONMENT =============
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
